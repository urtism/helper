{
    "id": "Germline-only-freebayes",
    "design": "cohort",
    "analysis": "Germline",
    "reference_version": "hg19",
    "workflow": [
        "prealignment",
        "alignment",
        "preprocessing",
        "variantcalling",
        "postprocessing",
        "variant_annotation",
        "postannotation"
    ],
    "prealignment": {
        "workflow": [
            "fastq_QC"
        ],
        "threads": "1",
        "ram": "1g",
        "trim_adapters": {
            "tool": "CUTADAPT",
            "adapter1": "CTGTCTCTTATACACATCT",
            "adapter2": "CTGTCTCTTATACACATCT",
            "tag": "",
            "CUTADAPT": {
                "args": []
            }
        },
        "filter_fastq_by_qual": {
            "tool": "CUTADAPT",
            "base_quality": "25",
            "CUTADAPT": {
                "args": []
            }
        },
        "filter_fastq_by_len": {
            "tool": "CUTADAPT",
            "maxlen": "150",
            "minlen": "100",
            "CUTADAPT": {
                "args": []
            }
        },
        "fastq_QC": {
            "tool": "FASTQC v.0.11.8",
            "FASTQC v.0.11.8": {
                "args": []
            }
        }
    },
    "alignment": {
        "workflow": [
            "fastq_alignment",
            "sam_to_bam",
            "sortSam",
            "bam_QC"
        ],
        "threads": "6",
        "ram": "1g",
        "merge_UMI": {
            "tool": ""
        },
        "fastq_alignment": {
            "tool": "BWA v.0.7.17",
            "BWA v.0.7.17": {
                "args": [],
                "algorithm": "mem"
            }
        },
        "sam_to_bam": {
            "tool": "PICARD v.2.7.1",
            "PICARD v.2.7.1": {
                "args": []
            }
        },
        "sortSam": {
            "tool": "PICARD v.2.7.1",
            "PICARD v.2.7.1": {
                "args": [
                    "SORT_ORDER=coordinate"
                ]
            }
        },
        "bam_QC": {
            "tool": "FASTQC v.0.11.8",
            "FASTQC v.0.11.8": {
                "args": []
            }
        }
    },
    "preprocessing": {
        "workflow": [
            "add_readgroups",
            "mark_pcr_dup",
            "indel_realignment",
            "BQ_recalibration"
        ],
        "threads": "2",
        "ram": "1g",
        "filter_bam": {
            "tool": ""
        },
        "merge_UMI": {
            "tool": ""
        },
        "add_readgroups": {
            "tool": "PICARD v.2.7.1",
            "PICARD v.2.7.1": {
                "args": []
            }
        },
        "mark_pcr_dup": {
            "tool": "PICARD v.2.7.1",
            "PICARD v.2.7.1": {
                "args": []
            }
        },
        "indel_realignment": {
            "tool": "GATK v.3.7",
            "GATK v.3.7": {
                "args": [],
                "mills": "MILLS"
            }
        },
        "BQ_recalibration": {
            "tool": "GATK v.3.7",
            "GATK v.3.7": {
                "args": [],
                "dbsnp": "DBSNP v.138",
                "mills": "MILLS"
            }
        }
    },
    "variantcalling": {
        "tools": [
            "FREEBAYES v.1.1"
        ],
        "threads": "6",
        "ram": "2g",
        "filters": {
            "min_base_quality_score": "",
            "min_alt_coverage": "",
            "min_alt_freq": "",
            "min_mapping_quality_score": ""
        },
        "GATK v.4.1": {
            "args": []
        },
        "FREEBAYES v.1.1": {
            "args": [
                "ciao"
            ]
        },
        "samples_org": "cohort"
    },
    "cnvcalling": {
        "tools": [
            "GATK v.4.1"
        ],
        "threads": "6",
        "ram": "2g",
        "GATK v.4.1": {
            "args": []
        },
        "DECON": {
            "args": [
                "--transProb",
                "0.01"
            ]
        },
        "CONVADING": {
            "args": []
        },
        "CNVkit": {
            "args": [],
            "algorithm": "hmm-germline",
            "threshold": ""
        },
        "samples_org": "single-sample",
        "CNVKIT": {
            "args": []
        }
    },
